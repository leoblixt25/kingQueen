rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players collection - Public read, authenticated write
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Matches collection - Public read, authenticated write
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Final Matches collection - Public read, authenticated write
    match /finalMatches/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tournament Settings - Read public, Write authenticated
    match /tournamentSettings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admins collection - Read public (for admin checks), write none
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Group Stage + Double Elimination (isolated new format) — ADDITIVE.
    // Lives in a new `tournaments/{id}` collection, never in the K&Q
    // collections above. The formatId discriminator prevents this rule
    // from being used to touch foreign documents in the same collection.
    // Public read mirrors the K&Q read policy so the live view works.
    //
    // Admin identity mirrors the client-side isAdmin() email check. A signed-
    // in player may only (a) register themselves once or (b) add ONE score
    // submission under their own uid; existing submissions are immutable, so
    // a player cannot edit a submitted score. Only the admin may correct any
    // score. All K&Q rules above are intentionally left untouched.
    // ------------------------------------------------------------------
    function gsdeAdmin() {
      return request.auth != null
             && request.auth.token.email == 'leo.blixt77@gmail.com';
    }

    function gsdeFormatGuard() {
      return resource.data.formatId == 'group-double-elimination'
             && request.resource.data.formatId == 'group-double-elimination';
    }

    // The derived pairing index mirrors approval state and active team for
    // each player. It lets rules authorise pairing without giving players any
    // write access to the registration records themselves. Admin writes rebuild
    // it atomically with every approval / team change.
    function gsdeEligiblePlayer(index, uid) {
      let entry = index.get(uid, null);
      return entry != null
             && entry.get('status', '') == 'approved'
             && entry.get('teamId', null) == null;
    }

    function gsdePairingIndexUnchanged() {
      let before = resource.data.get('playerPairingIndex', {});
      let after = request.resource.data.get('playerPairingIndex', {});
      return after.diff(before).affectedKeys().size() == 0;
    }

    function gsdePairingIndexAccepted(inviterUid, teamId) {
      let before = resource.data.get('playerPairingIndex', {});
      let after = request.resource.data.get('playerPairingIndex', {});
      let diff = after.diff(before);
      let inviterBefore = before.get(inviterUid, null);
      let inviteeBefore = before.get(request.auth.uid, null);
      let inviterAfter = after.get(inviterUid, null);
      let inviteeAfter = after.get(request.auth.uid, null);
      return diff.addedKeys().size() == 0
             && diff.removedKeys().size() == 0
             && diff.changedKeys().size() == 2
             && diff.changedKeys().hasOnly([inviterUid, request.auth.uid])
             && gsdeEligiblePlayer(before, inviterUid)
             && gsdeEligiblePlayer(before, request.auth.uid)
             && inviterBefore != null && inviteeBefore != null
             && inviterAfter != null && inviteeAfter != null
             && inviterAfter.get('status', '') == 'approved'
             && inviteeAfter.get('status', '') == 'approved'
             && inviterAfter.get('teamId', null) == teamId
             && inviteeAfter.get('teamId', null) == teamId;
    }

    function gsdeSelfRegistrationIndex() {
      let hasIndex = resource.data.keys().hasAny(['playerPairingIndex']);
      let before = resource.data.get('playerPairingIndex', {});
      let after = request.resource.data.get('playerPairingIndex', {});
      let diff = after.diff(before);
      let mine = after.get(request.auth.uid, null);
      let mineOk = mine != null
                   && mine.get('status', '') == 'pending'
                   && mine.get('teamId', null) == null;
      // Legacy documents predate the derived index. Let the first registration
      // seed it, but require exactly one entry per registration so a player
      // cannot inject arbitrary identities. Once present, every later write
      // must add only the caller's own entry and leave the rest untouched.
      let legacyOk = !hasIndex
                     && after.keys().size() == request.resource.data.registrations.size();
      let steadyOk = hasIndex
                     && diff.addedKeys().size() == 1
                     && diff.addedKeys().hasOnly([request.auth.uid])
                     && diff.changedKeys().size() == 0
                     && diff.removedKeys().size() == 0;
      return mineOk && (legacyOk || steadyOk);
    }

    // Pairing invitations live only in this document. Each branch allows one
    // specific player action and nothing else: sending/withdrawing touches only
    // the invitation map; responding may additionally create the single confirmed
    // team on acceptance. Admin-only fields (registrations, groups, matches,
    // bracket, setup) are never writable through these player branches.
    function gsdePairingSendWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeInvites = before.get('pairingInvitations', {});
      let afterInvites = after.get('pairingInvitations', {});
      let diff = afterInvites.diff(beforeInvites);
      let mine = afterInvites.get(request.auth.uid, null);
      let invitee = mine == null ? '' : mine.inviteeUid;
      return after.diff(before).affectedKeys().hasOnly([
               'pairingInvitations', 'auditLog', 'tournament'
             ])
        && diff.addedKeys().size() == 1
        && diff.addedKeys().hasOnly([request.auth.uid])
        && diff.changedKeys().size() == 0
        && diff.removedKeys().size() == 0
        && mine != null
        && mine.inviterUid == request.auth.uid
        && mine.inviteeUid != request.auth.uid
        && mine.status == 'pending'
        && mine.teamId == null
        && gsdePairingIndexUnchanged()
        && gsdeEligiblePlayer(before.get('playerPairingIndex', {}), request.auth.uid)
        && gsdeEligiblePlayer(before.get('playerPairingIndex', {}), invitee);
    }

    function gsdePairingCancelWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeInvites = before.get('pairingInvitations', {});
      let afterInvites = after.get('pairingInvitations', {});
      let diff = afterInvites.diff(beforeInvites);
      let mine = afterInvites.get(request.auth.uid, null);
      return after.diff(before).affectedKeys().hasOnly([
               'pairingInvitations', 'auditLog', 'tournament'
             ])
        && diff.changedKeys().size() == 1
        && diff.changedKeys().hasOnly([request.auth.uid])
        && diff.addedKeys().size() == 0
        && diff.removedKeys().size() == 0
        && mine != null
        && mine.inviterUid == request.auth.uid
        && mine.status == 'cancelled'
        && mine.teamId == null
        && gsdePairingIndexUnchanged()
        && gsdeEligiblePlayer(before.get('playerPairingIndex', {}), request.auth.uid);
    }

    function gsdePairingRespondWrite(accepted) {
      let before = resource.data;
      let after = request.resource.data;
      let beforeInvites = before.get('pairingInvitations', {});
      let afterInvites = after.get('pairingInvitations', {});
      let response = after.get('pairingResponses', {}).get(request.auth.uid, null);
      let invitationId = response == null ? '' : response.invitationId;
      let previous = beforeInvites.get(invitationId, null);
      let invitation = afterInvites.get(invitationId, null);
      return response != null
        && previous != null
        && invitation != null
        && after.diff(before).affectedKeys().hasOnly(accepted
             ? ['pairingInvitations', 'pairingResponses', 'teams', 'playerPairingIndex', 'auditLog', 'tournament']
             : ['pairingInvitations', 'pairingResponses', 'auditLog', 'tournament'])
        && previous.status == 'pending'
        && invitation.inviteeUid == request.auth.uid
        && invitation.status == (accepted ? 'accepted' : 'declined')
        && invitationId == invitation.id
        && response.teamId == invitation.teamId
        && afterInvites.diff(beforeInvites).changedKeys().size() == 1
        && afterInvites.diff(beforeInvites).changedKeys().hasOnly([response.invitationId])
        && afterInvites.diff(beforeInvites).addedKeys().size() == 0
        && afterInvites.diff(beforeInvites).removedKeys().size() == 0
        && after.get('pairingResponses', {}).diff(before.get('pairingResponses', {})).affectedKeys().hasOnly([request.auth.uid])
        && (after.get('pairingResponses', {}).diff(before.get('pairingResponses', {})).addedKeys().size() == 1
            || after.get('pairingResponses', {}).diff(before.get('pairingResponses', {})).changedKeys().size() == 1)
        && gsdeEligiblePlayer(before.get('playerPairingIndex', {}), request.auth.uid)
        && (accepted
             ? gsdePairingIndexAccepted(invitation.inviterUid, invitation.teamId)
             : gsdePairingIndexUnchanged())
        && (!accepted || (
             after.teams.size() == before.teams.size() + 1
             && after.teams.hasAll(before.teams)
             && after.teams[after.teams.size() - 1].id == invitation.teamId
             && after.teams[after.teams.size() - 1].status == 'confirmed'
             && after.teams[after.teams.size() - 1].groupId == null
             && after.teams[after.teams.size() - 1].playerIds.size() == 2
             && after.teams[after.teams.size() - 1].playerIds.hasOnly([
                  invitation.inviterUid, request.auth.uid
                ])
           ));
    }

    // Player writes append exactly one audit entry. The client keeps the log
    // bounded at 500 entries, so once it is full the newest entry displaces
    // the oldest and the size stays at 500. Accept both cases, but require the
    // newest entry to belong to the caller so players cannot forge history.
    function gsdeAuditAppend() {
      let beforeLog = resource.data.get('auditLog', []);
      let afterLog = request.resource.data.get('auditLog', []);
      let beforeSize = beforeLog.size();
      let afterSize = afterLog.size();
      return afterSize > 0
        && (afterSize == beforeSize + 1
            || (beforeSize >= 500 && afterSize == 500))
        && afterLog[afterSize - 1].actorId == request.auth.uid
        && (beforeSize == 0
            || afterLog[afterSize - 1] != beforeLog[beforeSize - 1]);
    }

    function gsdePlayerWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeSubs = before.get('scoreSubmissions', {});
      let afterSubs = after.get('scoreSubmissions', {});
      let myBefore = beforeSubs.get(request.auth.uid, {});
      let myAfter = afterSubs.get(request.auth.uid, {});
      return request.auth != null
        && gsdeFormatGuard()
        && after.tournament.diff(before.tournament).affectedKeys().hasOnly(['updatedAt'])
        && gsdeAuditAppend()
        && (
          // Self-registration: append exactly one PENDING record owned by the
          // caller, plus its derived index entry. Approval is admin-only.
          (after.diff(before).affectedKeys().hasOnly([
             'registrations', 'playerPairingIndex', 'auditLog', 'tournament'
           ])
            && after.registrations.size() == before.registrations.size() + 1
            && after.registrations[after.registrations.size() - 1].uid == request.auth.uid
            && after.registrations[after.registrations.size() - 1].status == 'pending'
            && after.registrations[after.registrations.size() - 1].teamId == null
            && ['male', 'female'].hasAny([
                 after.registrations[after.registrations.size() - 1].gender
               ])
            && gsdeSelfRegistrationIndex())
          ||
          // Score submission: only the caller's sub-map may gain one entry.
          // No existing submission may be changed or removed (submit-once).
          (after.diff(before).affectedKeys().hasOnly([
             'matches', 'elimination', 'scoreSubmissions', 'auditLog', 'tournament'
           ])
            && after.matches.size() == before.matches.size()
            && afterSubs.diff(beforeSubs).removedKeys().size() == 0
            && afterSubs.diff(beforeSubs).changedKeys().hasOnly([request.auth.uid])
            && afterSubs.diff(beforeSubs).addedKeys().hasOnly([request.auth.uid])
            && myAfter.diff(myBefore).addedKeys().size() == 1
            && myAfter.diff(myBefore).changedKeys().size() == 0
            && myAfter.diff(myBefore).removedKeys().size() == 0)
          ||
          // Pairing invitation lifecycle (player-owned, GSDE only).
          gsdePairingSendWrite()
          || gsdePairingCancelWrite()
          || gsdePairingRespondWrite(false)
          || gsdePairingRespondWrite(true)
        );
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.formatId == 'group-double-elimination';
      allow update: if (gsdeAdmin() && gsdeFormatGuard()) || gsdePlayerWrite();
      allow delete: if request.auth != null
                    && resource.data.formatId == 'group-double-elimination';
    }
  }
}
